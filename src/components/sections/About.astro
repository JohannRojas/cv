---
import Section from '../Section.astro'
import type { CV } from '@/cv'

interface Props {
  cv: CV;
  language?: 'en' | 'es';
}

const { cv, language = 'en' } = Astro.props;
const { basics } = cv;
const { summary } = basics

const title = language === 'en' ? 'About me' : 'Sobre mí';
---

<Section title={title}>
  <p>
    {summary}
  </p>
</Section>

<style>
  p {
    text-wrap: balance;
  }
</style>
