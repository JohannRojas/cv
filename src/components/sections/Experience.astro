---
import Section from '../Section.astro'
import External from '@/icons/External.astro'
import type { CV } from '@/cv'

interface Props {
  cv: CV;
  language?: 'en' | 'es';
}

const { cv, language = 'en' } = Astro.props;
const { work } = cv;

const title = language === 'en' ? 'Experience' : 'Experiencia';

// Función para formatear la fecha según el idioma
const formatDate = (date: string | null | undefined, lang: string) => {
  if (!date) return lang === 'en' ? 'Present' : 'Actual';
  
  // Si solo es un año, lo devolvemos tal cual
  if (/^\d{4}$/.test(date)) {
    return date;
  }
  
  // Si es un formato año-mes, lo formateamos
  if (/^\d{4}-\d{2}$/.test(date)) {
    const [year, month] = date.split('-');
    const monthNames = {
      en: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
      es: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic']
    };
    return `${monthNames[lang as 'en' | 'es'][parseInt(month) - 1]} ${year}`;
  }
  
  // Para otros formatos, devolvemos la fecha tal cual
  return date;
};
---

<Section title={title}>
  <ul>
    {
      work.map(
        ({
          name,
          startDate,
          endDate,
          position,
          summary,
          modalities,
          url,
          technologies,
        }) => {
          return (
            <li>
              <article>
                <header>
                  <div>
                    <h3>
                      {url ? (
                        <a href={url} title={`Ver ${name}`} target="_blank">
                          {name}
                        </a>
                      ) : (
                        <span>{name}</span>
                      )}
                      {url && (
                        <span class="external-icon">
                          <External />
                        </span>
                      )}
                    </h3>
                    <div>
                      <h4>{position}</h4>
                      <ul class="modalities">
                        {modalities?.map((modality) => (
                          <li>{modality}</li>
                        ))}
                      </ul>
                    </div>
                  </div>

                  <div>
                    <time datetime={startDate?.toString()} data-title={startDate?.toString()}>
                      {formatDate(startDate?.toString(), language)}
                    </time>
                    {startDate && ' - '}
                    <time datetime={endDate?.toString()} data-title={endDate?.toString()}>
                      {formatDate(endDate?.toString(), language)}
                    </time>
                  </div>
                </header>

                <footer>
                  <p>{summary}</p>
                  <ul class="technologies">
                    {technologies?.map((technology) => (
                      <li>{technology}</li>
                    ))}
                  </ul>
                </footer>
              </article>
            </li>
          )
        }
      )
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .technologies {
    margin-top: 0.5rem;
  }

  .modalities,
  .technologies {
    display: inline-flex;
    gap: 8px;
    flex-wrap: wrap;
    flex-direction: row;
  }
  .modalities li,
  .technologies li {
    align-items: center;
    background: #eee;
    border-radius: 6px;
    color: black;
    display: flex;
    font-size: 0.8rem;
    font-weight: 500;
    gap: 4px;
    padding: 0.2rem 0.6rem;
  }
  article h3 {
    font-weight: 500;
    color: #111;
    font-size: larger;
    display: flex;
    gap: 0.25rem;
  }
  article h3 .external-icon {
    display: flex;
    align-items: end;
    margin-bottom: 2px;
  }

  article a {
    color: #111;
  }

  article a:hover {
    text-decoration: underline;
    cursor: pointer;
  }

  article h4 {
    color: #222;
    font-weight: 400;
    display: inline-block;
    margin-top: 0.5rem;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  time {
    color: #555;
    font-size: 0.85rem;
    min-width: 102px;
    cursor: default;
  }

  footer p{
    text-wrap: balance;
  }

  [data-title]:hover:after {
    opacity: 1;
    transition: all 0.1s ease-in-out 0.5s;
    visibility: visible;
  }

  [data-title]:after {
    content: attr(data-title);
    background-color: #333;
    color: #fff;
    font-size: 0.75rem;
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      'Courier New',
      monospace;
    position: absolute;
    padding: 0.2rem 0.5rem;
    bottom: -1.4rem;
    left: 50%;
    white-space: nowrap;
    box-shadow: 1px 1px 1px #222222;
    opacity: 0;
    border: 1px solid #111111;
    z-index: 99999;
    visibility: hidden;
    border-radius: 6px;
  }

  [data-title] {
    position: relative;
  }

  @media (width <= 700px) {
    time {
      text-align: right;
    }
    h3 a {
      width: min-content; 
    }
  }

  @media print {
    .modalities li,
    .technologies li {
      align-items: center;
      background: #eee;
      border-radius: 6px;
      color: black;
      display: flex;
      font-size: 0.8rem;
      font-weight: 500;
      gap: 4px;
      padding: 0.2rem 0.6rem;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .external-icon {
      display: none !important;
    }
  }
</style>
